
# esex configuration

# bot credentials
YAPIN_BOT_TOKEN=YOUR_YAPIN_BOT_TOKEN
ESEX_BOT_ID=YOUR_BOT_ID

# groq ai
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# moderation
MOD_ROLE_IDS=YOUR_MOD_ROLE_ID
MOD_LOG_CHANNEL_ID=YOUR_MOD_LOG_CHANNEL_ID

# music settings
MUSY_IDLE_SECONDS=600
MUSY_MAX_MINUTES=240
MUSY_AUTOUPDATE=1

# sticky messages
STICKY_EVERY_MESSAGES=5
